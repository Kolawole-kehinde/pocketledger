NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://pocketledger_user:pocketledger_dev_password@localhost:5454/pocketledger_db
KAFKA_BROKERS=localhost:9094
REDIS_URL=redis://localhost:6379

# Auth JWT configuration. Every secret must be at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REGISTRATION_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=pocketledger
JWT_AUDIENCE=pocketledger-api
JWT_REGISTRATION_AUDIENCE=pocketledger-registration
JWT_ACCESS_TTL_SECONDS=900
JWT_REGISTRATION_TTL_SECONDS=900

# OTP and registration configuration
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
REGISTRATION_TTL_SECONDS=86400

# Refresh token and session configuration
REFRESH_TOKEN_HASH_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_TTL_SECONDS=2592000

# Refresh cookie configuration
AUTH_COOKIE_NAME=pocketledger_refresh
# AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_SECURE=false

# Background auth cleanup
AUTH_CLEANUP_ENABLED=true
AUTH_CLEANUP_INTERVAL_MS=300000

# In-process permission cache
CACHE_MAX_ENTRIES=10000
PERMISSION_CACHE_TTL_SECONDS=300

# Email payload encryption. Keys are base64-encoded 32-byte values.
EMAIL_PAYLOAD_ENCRYPTION_KEYS={"v1":"replace-with-base64-32-byte-key"}
EMAIL_PAYLOAD_ENCRYPTION_ACTIVE_VERSION=v1

# Email delivery: smtp | brevo
EMAIL_DELIVERY_DRIVER=smtp
EMAIL_OUTBOX_POLL_INTERVAL_MS=1000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PocketLedger
